{
  "expo": {
    "name": "Joule",
    "slug": "joule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rav.joule",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rav.joule",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Joule uses the microphone so you can log meals by speaking instead of typing."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Joule uses the camera to scan barcodes and read nutrition labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Joule accesses your photos so you can log a meal from a picture you already took."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "65ed6cb8-3930-4c8e-a10c-5b76b8d8d643"
      }
    },
    "owner": "ravmendis",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/65ed6cb8-3930-4c8e-a10c-5b76b8d8d643"
    }
  }
}